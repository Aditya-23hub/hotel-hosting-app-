<% layout("/layouts/boilerplate")%>
<br>
<br>
<br>
    
    <div class="row">
     <div class="col-8 offset-2">
    <div class="md-3">
     <h3>Create a New Listing  </h3>
     <label for="title" class="form-label">Title</label>
      
        <div class="invalid-feedback">
   please enter title
    </div>

     <div >
    <form method="Post" action="/listings" novalidate   class="needs-validation" >
        <input name="listing[title]" placeholder="enter title" type="text" class="form-control" required/>
        <!-- </div> -->
     <div  class="md-3">
           <label for="Description" class="form-label">Description</label>
           <textarea name="listing[description]" placeholder="enter description" 
           class="form-control" required></textarea>
           <!-- ///form validation error  -->
           <div class="invalid-feedback">
   please enter description
    </div>

     </div>
       
        <div  class="md-3">
          <label for="image-link" class="form-label">Image Link</label>
           <input name="listing[image]" placeholder="enter image URL/Link" type="text" class="form-control" required />
           <div class="invalid-feedback">
      please enter image link
    </div>
        </div>
<div class="row ">
     <div  class="md-3 col-md-4">
           <label for="price" class="form-label">Enter Price</label>
            <input name="listing[price]" placeholder="enter price" type="number" class="form-control" required />
            <div class="invalid-feedback">
      please enter price
    </div>
       </div>
       <div  class="md-3 col-md-8">
           <label for="Country_image" class="form-label" required >Enter Country Name</label>
 <input name="listing[country]" placeholder="enter country name" type="text" class="form-control" required />
  <div class="invalid-feedback">
      please enter country name
    </div>
       </div>
</div>
       
       
        <div  class="md-3">
           <label for="Location" class="form-label"> Enter Location</label>
           <input name="listing[location]" placeholder="enter location" type="text"class="form-control"  required/>
           <div class="invalid-feedback">
      please enter location
    </div>
        </div>
       <br>
    <br>
     
        
                 <button class="btn btn-dark">Add</button>
    </form>
    </div>
    </div>
    </div>
   
</body>
</html>